 "use client";
 
 import { useState, type FormEvent } from "react";
+import { siteConfig } from "@/lib/site-config";
 
 type FormState = "idle" | "sending" | "success" | "error";
 
+async function submitViaFormSubmit(input: {
+  name: string;
+  email: string;
+  message: string;
+}) {
+  const contactEmail =
+    process.env.NEXT_PUBLIC_CONTACT_EMAIL?.trim() || siteConfig.contactEmail;
+
+  const response = await fetch(
+    `https://formsubmit.co/ajax/${encodeURIComponent(contactEmail)}`,
+    {
+      method: "POST",
+      headers: {
+        "Content-Type": "application/json",
+        Accept: "application/json",
+      },
+      body: JSON.stringify({
+        name: input.name,
+        email: input.email,
+        message: input.message,
+        _replyto: input.email,
+        _subject: `Portfolio message from ${input.name}`,
+        _template: "table",
+      }),
+    },
+  );
+
+  const raw = await response.text();
+  let result: { success?: string | boolean; message?: string } = {};
+
+  try {
+    result = JSON.parse(raw) as typeof result;
+  } catch {
+    result = { message: raw.slice(0, 200) };
+  }
+
+  if (!response.ok) {
+    const lower = `${result.message || ""} ${raw}`.toLowerCase();
+    if (
+      lower.includes("activate") ||
+      lower.includes("confirm") ||
+      lower.includes("verify") ||
+      response.status === 403
+    ) {
+      throw new Error(
+        "Check your inbox and confirm the FormSubmit activation email, then try again.",
+      );
+    }
+    throw new Error(result.message || "Something went wrong. Please try again.");
+  }
+}
+
 export function ContactForm() {
   const [state, setState] = useState<FormState>("idle");
   const [errorMessage, setErrorMessage] = useState("");
